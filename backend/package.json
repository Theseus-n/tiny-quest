{
  "name": "@platform/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@platform/schema=../schema/src/index.ts --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@platform/schema": "*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
