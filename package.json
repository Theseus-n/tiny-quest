{
  "name": "tiny-quest",
  "private": true,
  "type": "module",
  "workspaces": [
    "schema",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build:backend -w frontend && npm run build -w backend",
    "test": "vitest run",
    "check": "node tools/check.mjs",
    "voices": "node tools/make-voices.mjs",
    "e2e": "playwright test",
    "start": "npm run start -w backend",
    "e2e:backend": "npm run build && playwright test -c playwright.backend.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
